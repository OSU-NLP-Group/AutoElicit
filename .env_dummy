# Anthropic API (Anthropic() client)
ANTHROPIC_API_KEY=

# OpenAI API (OpenAI() client)
OPENAI_API_KEY=

# AWS Bedrock API Credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Azure OpenAI API (AzureOpenAI() client)
AZURE_API_KEY=
AZURE_API_VERSION=
AZURE_ENDPOINT=

# AWS EC2 Hosting for OSWorld
# Reuses the AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION above via boto3's default credential chain.
AWS_SUBNET_ID=
AWS_SECURITY_GROUP_ID=
AWS_USE_PUBLIC_IP=
ENABLE_TTL=
AWS_AUTO_CREATE_SCHEDULER_ROLE=